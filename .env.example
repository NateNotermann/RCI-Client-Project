# Example .env file. Do NOT commit your real secrets.
SERVER_SESSION_SECRET='replace-with-a-random-secret'

# AWS RDS DATABASE URL (replace with your RDS endpoint)
DATABASE_URL='postgres://username:password@your-rds-endpoint:5432/database'

# AWS S3 Configuration
newAWS_ACCESS_KEY_ID='REPLACE_WITH_AWS_ACCESS_KEY_ID'
newAWS_SECRET_ACCESS_KEY='REPLACE_WITH_AWS_SECRET_ACCESS_KEY'
newAWS_REGION='us-east-1'
S3_BUCKET_NAME='your-s3-bucket-name'

# End of example
